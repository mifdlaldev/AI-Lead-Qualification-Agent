# ============================================
# AI Lead Qualification Agent — Configuration
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env.

# --- Environment ---
APP_ENV=dev
APP_BASE_URL=http://localhost:5678

# --- Versioning ---
WORKFLOW_RELEASE=1.0.0
INBOUND_SCHEMA_VERSION=1
SEMANTIC_SCHEMA_VERSION=1
POLICY_VERSION=1
PROMPT_VERSION=1

# --- n8n ---
N8N_ENCRYPTION_KEY=change-me-to-a-random-string
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_USER_MANAGEMENT_DISABLED=true

# --- PostgreSQL (Supabase) ---
# Application database (canonical domain state)
PG_APP_HOST=db.xxxxx.supabase.co
PG_APP_PORT=5432
PG_APP_DATABASE=postgres
PG_APP_USER=postgres
PG_APP_PASSWORD=change-me
PG_APP_SSL_MODE=require

# n8n internal database
PG_N8N_HOST=db.xxxxx.supabase.co
PG_N8N_PORT=5432
PG_N8N_DATABASE=postgres
PG_N8N_SCHEMA=n8n
PG_N8N_USER=postgres
PG_N8N_PASSWORD=change-me
PG_N8N_SSL_MODE=true

# --- AI / LLM ---
AI_PROVIDER=omni
AI_BASE_URL=https://omni.thefreelancer.web.id/v1
AI_API_KEY=change-me
OPENAI_MODEL=gpt-4o-mini

# --- Telegram ---
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_CHAT_ID=change-me

# --- Resend (Email) ---
RESEND_API_KEY=change-me
EMAIL_FROM=noreply@example.com

# --- Human Review ---
REVIEW_TOKEN_TTL_SECONDS=86400
REVIEW_TOKEN_SECRET=change-me

# --- Retry / Backoff ---
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_MS=1000
RETRY_BACKOFF_MULTIPLIER=2