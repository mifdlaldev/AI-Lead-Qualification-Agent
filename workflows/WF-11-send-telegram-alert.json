      "typeVersion": 1,
      "position": [1500, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE side_effects\nSET status = 'IN_PROGRESS',\n    attempt_count = attempt_count + 1\nWHERE action_key = '{{ $('Prep Input').item.json.action_key }}'\n  AND status IN ('PENDING', 'RETRY_PENDING')\nRETURNING id, action_key, action_type, status, attempt_count"
      },
      "id": "e11a0007-0000-4000-a000-000000000007",
      "name": "Update SE IN_PROGRESS",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1250, 400],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "Postgres"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "message_text",
              "value": "=<b>New Lead Alert</b>\n\n<b>Lead ID:</b> {{ $('Prep Input').item.json.lead_id }}\n<b>Disposition:</b> {{ $('Prep Input').item.json.disposition }}\n<b>Requires Review:</b> {{ $('Prep Input').item.json.requires_human_review }}\n<b>Reason Codes:</b> {{ $('Prep Input').item.json.reason_codes.join(', ') }}\n\n<b>Summary:</b> {{ $('Prep Input').item.json.lead_summary || 'No summary provided' }}\n\n<i>Action: {{ $('Prep Input').item.json.action_key }}</i>"
            },
            {
              "name": "chat_id",
              "value": "={{ $('Prep Input').item.json.chat_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e11a0008-0000-4000-a000-000000000008",
      "name": "Build Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [1500, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot{{$credentials.token}}/sendMessage",
        "authentication": "genericCredentialType",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{ $json.chat_id }}"
            },
            {
              "name": "text",
              "value": "={{ $json.message_text }}"
            },
            {
              "name": "parse_mode",
              "value": "HTML"
            }
          ]
        },
        "options": {
          "continueOnFail": true
        }
      },
      "id": "e11a0009-0000-4000-a000-000000000009",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1750, 400],
      "credentials": {
        "httpHeaderAuth": {
          "id": "2",
          "name": "Telegram"
        }
      }
    },
    {
      "parameters": {
