    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, status, attempt_count, provider_reference\nFROM side_effects\nWHERE action_key = '{{ $json.action_key }}'"
      },
      "id": "e11a0003-0000-4000-a000-000000000003",
      "name": "Check Action Key",
